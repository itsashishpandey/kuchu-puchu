// Kuchu Puchu — Creator Monetization Platform
// Prisma schema (SQLite). Changes go through versioned migrations in prisma/migrations
// (`npx prisma migrate dev --create-only` locally, `npx prisma migrate deploy` on servers).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Users & Auth ───────────────────────────────

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  passwordHash           String
  name                   String
  role                   String    @default("CREATOR") // CREATOR | ADMIN
  followsPrivate         Boolean   @default(false) // hide my name & country from creators I follow
  adminRole              String? // SUPER_ADMIN | MODERATOR | FINANCE (admins only)
  status                 String    @default("PENDING") // PENDING | APPROVED | REJECTED | SUSPENDED
  rejectionReason        String?
  suspensionReason       String?
  avatarUrl              String?
  phone                  String?
  country                String?
  emailVerified          Boolean   @default(false)
  emailVerifiedAt        DateTime?
  monetizationEligible   Boolean   @default(true)
  monetizationUnlockedAt DateTime? // set once the channel first reaches the monthly-views target; earning stays unlocked
  // creator application (KYC-lite)
  legalName              String? // as on the government ID
  city                   String?
  postalCode             String?
  agreements             String? // JSON {version, accepted[], at} — creator declarations at application time
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  channel       Channel?
  sessions      Session[]
  notifications Notification[]
  videos        Video[]
  ledgerEntries LedgerEntry[]
  withdrawals   Withdrawal[]
  follows       Follow[]             @relation("Follower")
  appeals       Appeal[]
  verification  CreatorVerification?
  strikes       ChannelStrike[]

  // personalization (viewers and creators alike)
  languagePrefs    UserLanguagePreference[]
  categoryPrefs    UserCategoryPreference[]
  subcategoryPrefs UserSubcategoryPreference[]
  recoPrefs        UserRecommendationPreference?
  savedVideos      SavedVideo[]
  videoFeedback    VideoFeedback[]
  blockedCreators  BlockedCreator[]              @relation("Blocker")
  blockedBy        BlockedCreator[]              @relation("BlockedCreator")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ─────────────────────────────── Channels ───────────────────────────────

model Channel {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  username       String   @unique
  description    String   @default("")
  tagline        String? // one line under the channel name (YouTube-style header)
  supportEmail   String? // public contact for viewers/brands — optional, creator-provided
  avatarUrl      String? // channel logo
  bannerUrl      String?
  category       String?
  country        String?
  socialLinks    String? // JSON: {instagram,youtube,x,tiktok,website}
  theme          String   @default("BLUE") // BLUE for boys' channels, PINK for girls' channels
  followerCount  Int      @default(0)
  verified       Boolean  @default(false)
  showEarnings   Boolean  @default(false) // consent to display verified earnings publicly
  paymentDetails String? // JSON: {method, accountName, maskedAccount}
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  videos    Video[]
  followers Follow[] @relation("Followed")

  // channel-level preferences — never replace per-video tagging
  preferredCategories ChannelCategoryPreference[]
  publishingLanguages ChannelLanguage[]

  @@index([username])
}

model Follow {
  id         String   @id @default(cuid())
  followerId String
  follower   User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  channelId  String
  channel    Channel  @relation("Followed", fields: [channelId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([followerId, channelId])
  @@index([channelId, createdAt])
}

// ─────────────────────────────── Videos ───────────────────────────────

model Video {
  id                   String    @id @default(cuid())
  contentId            String    @unique // VID-2026-000001
  creatorId            String
  creator              User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  channel              Channel   @relation(fields: [creatorId], references: [userId], onDelete: Cascade)
  title                String
  description          String    @default("")
  category             String // legacy display name = primary category name (tags live in VideoCategoryAssignment)
  hashtags             String    @default("[]") // JSON array
  videoUrl             String
  thumbnailUrl         String?
  duration             Float // seconds
  fileSizeMB           Float     @default(0)
  resolution           String    @default("720x1280")
  format               String    @default("mp4")
  status               String    @default("PENDING") // PENDING | APPROVED | REJECTED | FLAGGED_DUPLICATE | REMOVED
  rejectionReason      String?
  // fingerprinting
  sha256               String?
  visualHash           String? // 64-bit perceptual hash (hex)
  audioHash            String? // 64-bit audio fingerprint (hex)
  duplicateOfId        String? // contentId of matched original
  similarityScore      Float?
  duplicateStatus      String? // PENDING_REVIEW | CONFIRMED_DUPLICATE | FALSE_POSITIVE
  // monetization
  uploadRewardCredited Boolean   @default(false)
  monetizationEnabled  Boolean   @default(true)
  earningExpiresAt     DateTime?
  publishedAt          DateTime?
  // stats
  views                Int       @default(0)
  qualifiedViews       Int       @default(0)
  likes                Int       @default(0)
  commentsCount        Int       @default(0)
  shares               Int       @default(0)
  featured             Boolean   @default(false)
  // language & category tagging review
  tagStatus            String    @default("OK") // OK | NEEDS_REVIEW | FLAGGED
  tagFlagReason        String?
  tagSuggestions       String? // JSON snapshot of automated suggestions shown at upload
  tagsUpdatedAt        DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  viewEvents    ViewEvent[]
  comments      Comment[]
  likesRel      VideoLike[]
  ledgerEntries LedgerEntry[]
  reports       ContentReport[]
  appeals       Appeal[]
  languages     VideoLanguage[]
  tags          VideoCategoryAssignment[]
  saves         SavedVideo[]
  feedback      VideoFeedback[]
  interactions  VideoInteractionEvent[]

  @@index([status, publishedAt])
  @@index([creatorId])
}

model VideoLike {
  id        String   @id @default(cuid())
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  userId    String?
  guestKey  String
  createdAt DateTime @default(now())

  @@unique([videoId, guestKey])
}

model Comment {
  id           String   @id @default(cuid())
  videoId      String
  video        Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  userId       String?
  authorName   String
  authorAvatar String?
  body         String
  createdAt    DateTime @default(now())
}

model ViewEvent {
  id              String   @id @default(cuid())
  videoId         String
  video           Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  viewerKey       String // hashed ip+ua device key
  networkKey      String? // hashed internet connection (IPv4 address / IPv6 /64) — caps views per shared connection
  isSelf          Boolean  @default(false)
  qualified       Boolean  @default(false)
  reason          String? // disqualification reason
  watchSeconds    Float    @default(0)
  durationSeconds Float? // video length at view time (for completion rate)
  userId          String? // signed-in viewer (null for guests)
  country         String? // no longer collected (kids' platform, since 0007); kept for old rows' schema only
  createdAt       DateTime @default(now())

  @@index([videoId, viewerKey])
  @@index([videoId, networkKey, createdAt])
  @@index([videoId, createdAt])
  @@index([userId, createdAt])
}

model ContentReport {
  id          String   @id @default(cuid())
  videoId     String
  video       Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  reporterKey String
  userId      String? // signed-in reporter, so their feed stops showing the video
  reason      String // COPYRIGHT | INAPPROPRIATE | SPAM | OTHER
  details     String?
  status      String   @default("OPEN") // OPEN | REVIEWING | RESOLVED
  createdAt   DateTime @default(now())
}

model Appeal {
  id        String   @id @default(cuid())
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String
  status    String   @default("OPEN") // OPEN | APPROVED | REJECTED
  createdAt DateTime @default(now())
}

// ─────────────────────────────── Monetization ───────────────────────────────

// Append-only rate settings: newest row = active, all rows = historical rates
model MonetizationSetting {
  id                         String   @id @default(cuid())
  ratePer1000Views           Float    @default(1.0)
  rewardPerUpload            Float    @default(0.32) // USD actually credited = rewardPerUploadInr / inrPerUsd
  rewardPerUploadInr         Float    @default(30) // the reward creators are promised, in INR
  inrPerUsd                  Float    @default(95) // admin-set exchange rate used for the conversion
  minMonthlyChannelViews     Int      @default(2500) // a channel earns only with this many genuine views in the last 30 days
  monetizationDurationMonths Int      @default(4)
  minWithdrawalAmount        Float    @default(25.0)
  holdingPeriodDays          Int      @default(7)
  monetizationPaused         Boolean  @default(false)
  effectiveDate              DateTime @default(now())
  active                     Boolean  @default(true)
  createdBy                  String?
  createdAt                  DateTime @default(now())
}

model UploadRule {
  id                     String   @id @default(cuid())
  minDurationSec         Int      @default(20)
  maxDurationSec         Int      @default(90)
  maxFileSizeMB          Int      @default(200)
  maxResolution          String   @default("1080p")
  formats                String   @default("mp4,mov")
  maxDailyUploads        Int      @default(2)
  maxWeeklyUploads       Int      @default(4)
  requireVideoApproval   Boolean  @default(true)
  rewardRequiresApproval Boolean  @default(true)
  updatedAt              DateTime @updatedAt
}

// Immutable earnings ledger
model LedgerEntry {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId      String?
  video        Video?    @relation(fields: [videoId], references: [id], onDelete: SetNull)
  type         String // UPLOAD_REWARD | VIEW_EARNING | ADJUSTMENT | WITHDRAWAL_HOLD | WITHDRAWAL_PAID | WITHDRAWAL_REJECTED
  amount       Float // positive = credit, negative = debit
  status       String    @default("PENDING") // PENDING (in holding) | AVAILABLE | FINALIZED | REVERSED
  availableAt  DateTime? // when funds become withdrawable
  rateSnapshot Float? // rate per 1000 views at credit time
  description  String
  reference    String? // internal reference e.g. TXN-...
  withdrawalId String?
  createdAt    DateTime  @default(now())
}

model Withdrawal {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount     Float
  method     String // BANK_TRANSFER | PAYPAL
  details    String // JSON with masked account info
  status     String   @default("REQUESTED") // REQUESTED | UNDER_REVIEW | APPROVED | PROCESSING | PAID | REJECTED
  adminNote  String?
  paymentRef String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─────────────────────────────── Platform ───────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // APPLICATION_SUBMITTED | ACCOUNT_STATUS | VIDEO_STATUS | DUPLICATE | LIMIT | EARNING | MONETIZATION | WITHDRAWAL | WARNING | ANNOUNCEMENT
  title     String
  body      String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

// Simulated outbound email log (demo environment — no SMTP available)
model MailLog {
  id        String   @id @default(cuid())
  toEmail   String
  subject   String
  body      String
  createdAt DateTime @default(now())
}

// Main video categories (31: the 30 specified + "Kids & Cartoons"). The 12 original kids categories
// were retired into Kids & Cartoons subcategories (mergedIntoId) — kept, never deleted.
model Category {
  id            String    @id @default(cuid())
  name          String    @unique
  slug          String    @unique
  icon          String? // lucide icon name (admin)
  emoji         String? // shown on cards/bubbles in web + app
  color         String? // hex accent
  coverImageUrl String?
  description   String?
  keywords      String    @default("[]") // JSON search/suggestion synonyms
  sortOrder     Int       @default(100)
  active        Boolean   @default(true)
  retiredAt     DateTime? // retired: hidden from new tagging/onboarding, history kept
  mergedIntoId  String? // category id (or "sub:<subcategoryId>") this one was merged into
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  subcategories Subcategory[]
  translations  CategoryTranslation[]
  assignments   VideoCategoryAssignment[]
  userPrefs     UserCategoryPreference[]
  channelPrefs  ChannelCategoryPreference[]

  @@index([active, sortOrder])
}

model Subcategory {
  id           String    @id @default(cuid())
  categoryId   String
  category     Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name         String
  slug         String
  emoji        String?
  description  String?
  keywords     String    @default("[]") // JSON search/suggestion synonyms
  sortOrder    Int       @default(100)
  active       Boolean   @default(true)
  retiredAt    DateTime?
  mergedIntoId String? // subcategory id this one was merged into
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  translations CategoryTranslation[]
  assignments  VideoCategoryAssignment[]
  userPrefs    UserSubcategoryPreference[]

  @@unique([categoryId, slug])
  @@unique([categoryId, name])
  @@index([active])
}

// Localized names for interface languages (one row per locale per category OR subcategory)
model CategoryTranslation {
  id            String       @id @default(cuid())
  locale        String // interface locale, e.g. "hi"
  categoryId    String?
  category      Category?    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategoryId String?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt

  @@unique([locale, categoryId])
  @@unique([locale, subcategoryId])
}

// ───────────────────────── Languages ─────────────────────────

model Language {
  id         String   @id @default(cuid())
  code       String   @unique // BCP 47 tag used in URLs/APIs, e.g. "hi", "zh-Hans", "pnb"
  iso6391    String? // two-letter ISO 639-1 where one exists
  iso6393    String // three-letter ISO 639-3
  nameEn     String
  nameNative String
  script     String // ISO 15924, e.g. "Deva"
  direction  String   @default("LTR") // LTR | RTL
  region     String?
  group      String   @default("INTERNATIONAL") // INDIAN | INTERNATIONAL
  popular    Boolean  @default(false) // shown first in pickers
  priority   Int      @default(100) // display order (lower first)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  userPrefs UserLanguagePreference[]
  videos    VideoLanguage[]
  channels  ChannelLanguage[]

  @@index([active, priority])
}

// ───────────────────────── Video tagging ─────────────────────────

// position 1 = primary language; at most 3 per video (CHECK constraint in the migration)
model VideoLanguage {
  id         String   @id @default(cuid())
  videoId    String
  video      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  languageId String
  language   Language @relation(fields: [languageId], references: [id], onDelete: Restrict)
  position   Int // 1 = primary, 2–3 = additional
  isPrimary  Boolean  @default(false)
  source     String   @default("CREATOR") // CREATOR | ADMIN | BACKFILL
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([videoId, languageId])
  @@unique([videoId, position])
  @@index([languageId, isPrimary])
}

// priority 1 = primary category; at most 3 distinct main categories per video (CHECK + uniques)
model VideoCategoryAssignment {
  id            String      @id @default(cuid())
  videoId       String
  video         Video       @relation(fields: [videoId], references: [id], onDelete: Cascade)
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategoryId String
  subcategory   Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  priority      Int // 1 primary, 2 secondary, 3 third
  source        String      @default("CREATOR") // CREATOR | ADMIN | BACKFILL | MERGE
  assignedById  String?
  updatedById   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt

  @@unique([videoId, categoryId])
  @@unique([videoId, priority])
  @@index([categoryId])
  @@index([subcategoryId])
}

// ───────────────────────── Viewer preferences & feedback ─────────────────────────

model UserLanguagePreference {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  languageId String
  language   Language @relation(fields: [languageId], references: [id], onDelete: Cascade)
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([userId, languageId])
  @@index([languageId])
}

model UserCategoryPreference {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  allSubcategories Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@unique([userId, categoryId])
  @@index([categoryId])
}

model UserSubcategoryPreference {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  subcategoryId String
  subcategory   Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([userId, subcategoryId])
  @@index([subcategoryId])
}

// User-controlled discovery + onboarding state (one row per user)
model UserRecommendationPreference {
  userId                 String    @id
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  discoverOtherLanguages Boolean   @default(false)
  interfaceLocale        String    @default("en")
  onboardingStep         Int       @default(0)
  onboardingDraft        String? // JSON progress of an interrupted onboarding
  onboardingCompletedAt  DateTime?
  learnedResetAt         DateTime? // behaviour before this moment is ignored by the ranker
  prefsVersion           Int       @default(0) // bumped on every change → fresh feed
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @default(now()) @updatedAt
}

model SavedVideo {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, videoId])
}

model VideoFeedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId   String
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  kind      String   @default("NOT_INTERESTED")
  createdAt DateTime @default(now())

  @@unique([userId, videoId, kind])
}

model BlockedCreator {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("Blocker", fields: [userId], references: [id], onDelete: Cascade)
  creatorId String
  creator   User     @relation("BlockedCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, creatorId])
}

// Recommendation signals. Data minimization: no IP, no free text; pruned after 180 days.
model VideoInteractionEvent {
  id           String   @id @default(cuid())
  videoId      String
  video        Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  userId       String?
  viewerKey    String
  type         String // VIEW | COMPLETE | LIKE | UNLIKE | SAVE | UNSAVE | SHARE | NOT_INTERESTED | HIDE_CREATOR | REPORT
  watchSeconds Float?
  completion   Float? // 0..1
  suspicious   Boolean  @default(false) // disqualified view (bot/self/rapid) — ignored for learning
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([videoId, type])
  @@index([createdAt])
}

// ───────────────────────── Channel preferences ─────────────────────────

model ChannelCategoryPreference {
  id         String   @id @default(cuid())
  channelId  String
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([channelId, categoryId])
}

model ChannelLanguage {
  id         String   @id @default(cuid())
  channelId  String
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  languageId String
  language   Language @relation(fields: [languageId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([channelId, languageId])
}

// ───────────────────────── Recommendation config & audit ─────────────────────────

model RecommendationConfig {
  id                String   @id @default(cuid())
  version           Int      @unique
  label             String
  status            String   @default("ARCHIVED") // ACTIVE | EXPERIMENT | ARCHIVED
  settings          String // JSON (weights, limits) — validated server-side within safe bounds
  experimentPercent Int      @default(0)
  notes             String?
  createdById       String?
  createdByEmail    String?
  effectiveFrom     DateTime @default(now())
  createdAt         DateTime @default(now())
}

model TaxonomyAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorEmail String
  action     String
  entityType String // LANGUAGE | CATEGORY | SUBCATEGORY | TRANSLATION | VIDEO_TAGS | RECO_CONFIG
  entityId   String?
  before     String? // JSON snapshot
  after      String? // JSON snapshot
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// Anonymous search analytics (no user id, no IP)
model SearchLog {
  id          String   @id @default(cuid())
  query       String
  normalized  String
  interpreted String? // JSON of detected language/category/subcategory
  resultCount Int
  createdAt   DateTime @default(now())

  @@index([normalized])
  @@index([createdAt])
}

model FraudFlag {
  id        String   @id @default(cuid())
  userId    String? // flagged creator
  videoId   String? // contentId
  type      String // VIEW_BOT | SELF_VIEW | RAPID_REFRESH | DUPLICATE_CONTENT | UNUSUAL_PATTERN | FAKE_ENGAGEMENT
  severity  String   @default("MEDIUM") // LOW | MEDIUM | HIGH
  details   String
  status    String   @default("OPEN") // OPEN | DISMISSED | CONFIRMED
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorEmail String
  action     String
  targetType String // CREATOR | VIDEO | WITHDRAWAL | SETTING | EARNING | ...
  targetId   String?
  details    String?
  createdAt  DateTime @default(now())
}

// Generic key-value platform settings (branding, SEO, homepage, payments, policies)
model PlatformSetting {
  key       String   @id
  value     String // JSON
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  category  String
  subject   String
  message   String
  status    String   @default("NEW") // NEW | IN_PROGRESS | RESOLVED
  createdAt DateTime @default(now())
}

// ───────────────────────── Creator application: email OTP, ID check, strikes ─────────────────────────

// 6-digit email codes (hash only). A verified code yields a one-time token the application must present.
model EmailOtp {
  id         String    @id @default(cuid())
  email      String
  purpose    String // CREATOR_SIGNUP
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  token      String?   @unique
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
}

// One government ID per creator. The file lives in a PRIVATE folder (never web-served); admins only.
model CreatorVerification {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentType    String // AADHAAR | PAN | PASSPORT | DRIVING_LICENCE | VOTER_ID | NATIONAL_ID | OTHER
  documentLast4   String
  fileName        String
  mimeType        String
  status          String    @default("PENDING") // PENDING | VERIFIED | REJECTED
  reviewNote      String?
  reviewedById    String?
  reviewedByEmail String?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
}

// Upheld complaints. 3 active strikes → channel suspended (an admin decides on deletion).
model ChannelStrike {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentId      String?
  reportId       String?
  reason         String
  createdById    String
  createdByEmail String
  revokedAt      DateTime?
  revokedById    String?
  revokeNote     String?
  createdAt      DateTime  @default(now())

  @@index([userId, revokedAt])
}
